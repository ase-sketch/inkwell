{
    "compilerOptions": {
        "target": "ES2023",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "strict": true,
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "noUncheckedIndexedAccess": true,
        "exactOptionalPropertyTypes": true,
        "verbatimModuleSyntax": true,
        "skipLibCheck": true,
        "types": [
            "bun-types",
            "node"
        ]
    },
    "include": [
        "src/**/*.ts",
        "tests/**/*.ts"
    ]
}

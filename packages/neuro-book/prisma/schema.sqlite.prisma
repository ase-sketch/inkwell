// App SQLite schema. This database lives at Workspace Root .nbook and stores
// only application-level data such as users and global locks.
generator client {
  provider = "prisma-client"
  output   = "../server/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum UserRole {
  admin
  user
}

enum UserStatus {
  active
  disabled
}

model User {
  id             Int        @id @default(autoincrement())
  username       String     @unique
  displayName    String     @default("")
  passwordHash   String
  role           UserRole   @default(user)
  status         UserStatus @default(active)
  sessionVersion Int        @default(1)
  lastLoginAt    DateTime?
  lastSeenAt     DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @default(now()) @updatedAt

  @@index([role, status])
  @@index([lastSeenAt])
  @@index([updatedAt])
}

model DatabaseLock {
  key       Int      @id
  updatedAt DateTime @default(now()) @updatedAt
}

// 章节快照（M7：章节快照时光机）。作者主动给正文打的命名存档点。
// 只存指针：章节路径 + 指向 nb-history 时间线条目的 entryId + 可选备注 + 拍摄时间；
// 正文与版本内容一律由 nb-history 快照提供，本表不存正文。
model ChapterSnapshot {
  id        Int      @id @default(autoincrement())
  path      String
  entryId   Int
  note      String?
  createdAt DateTime @default(now())

  @@index([path])
}

// Passport 凭据：一个账号槽位持有一份官方站授权（Task 112 spec §11；v1 只有 default 槽位）
model PassportCredential {
  id                 Int      @id @default(autoincrement())
  slotId             String   @unique @default("default") // 账号槽位，v1 恒为 default，预留多槽位切换
  accountId          Int // 官方站账号 id（展示用）
  accountUsername    String
  accountDisplayName String
  scopesJson         String // JSON string[]，已授权 scope
  refreshToken       String // 官方站 refresh token；存 State Root 内 App SQLite，与 .env 同级安全边界
  linkedAt           DateTime @default(now())
  updatedAt          DateTime @default(now()) @updatedAt
}

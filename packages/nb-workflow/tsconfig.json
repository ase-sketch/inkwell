{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "esModuleInterop": true,
        "noEmit": true,
        "types": ["bun-types"],
        "skipLibCheck": true
    },
    "include": ["src", "test"]
}

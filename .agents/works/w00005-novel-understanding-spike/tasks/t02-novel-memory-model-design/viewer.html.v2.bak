<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>记忆图查看器 · nbook.novel-memory/v2-spike</title>
<style>
/* ─────────────────────────────────────────────────────────
   宣纸 / 墨 / 朱批 / 石绿
   认识论状态在亮色下渲染成墨色浓度：narrated 是浓墨，
   inference 是飞白。同一套规则作用在卡片、边、节点上。
   ───────────────────────────────────────────────────────── */
:root{
  --paper:#f3f2f7; --card:#ffffff; --sunk:#eceaf3;
  --ink:#1b1830; --ink2:#4a4660; --ink3:#8b87a3; --ink4:#b3b0c4;
  --rule:#dedbe8; --rule2:#eae8f1;
  --gold:#a87515; --gold-bg:rgba(168,117,21,.09);
  --cinnabar:#c7304f; --cinnabar-bg:rgba(199,48,79,.07);
  --verdi:#1e8a74;
  --f-display:"Noto Serif SC","Songti SC",serif;
  --f-body:"Noto Sans SC","PingFang SC","Microsoft YaHei",sans-serif;
  --f-mono:"Chivo Mono",ui-monospace,"Consolas",monospace;
}
*{box-sizing:border-box}
html,body{height:100%}
body{
  margin:0;background:var(--paper);color:var(--ink);
  font-family:var(--f-body);font-weight:300;font-size:13px;line-height:1.75;
  -webkit-font-smoothing:antialiased;overflow:hidden;
}
button{font:inherit;color:inherit}
::selection{background:rgba(168,117,21,.2)}
:focus-visible{outline:2px solid var(--gold);outline-offset:2px;border-radius:2px}

.app{display:grid;grid-template-rows:auto 1fr;height:100%}

/* ── 顶栏 ─────────────────────────────────────────────── */
.bar{
  display:flex;align-items:center;gap:16px;padding:0 16px;height:50px;
  background:var(--card);border-bottom:1px solid var(--rule);flex-wrap:nowrap;
}
.brand{font-family:var(--f-display);font-weight:700;font-size:15px;letter-spacing:.04em;white-space:nowrap}
.schema{font-family:var(--f-mono);font-size:10px;color:var(--ink3);letter-spacing:.06em;white-space:nowrap}
.bar-sp{flex:1}
.search{
  width:210px;padding:6px 10px;border:1px solid var(--rule);border-radius:3px;
  background:var(--paper);font-family:var(--f-body);font-size:12.5px;color:var(--ink);
}
.search::placeholder{color:var(--ink4)}
.btn{
  background:var(--card);border:1px solid var(--rule);border-radius:3px;
  padding:6px 12px;font-size:12px;cursor:pointer;white-space:nowrap;transition:.15s;
}
.btn:hover{border-color:var(--ink3);background:var(--sunk)}
.badge{
  font-family:var(--f-mono);font-size:11px;padding:5px 11px;border-radius:3px;cursor:pointer;
  border:1px solid transparent;white-space:nowrap;
}
.badge.ok{background:rgba(30,138,116,.1);color:var(--verdi);border-color:rgba(30,138,116,.28)}
.badge.bad{background:var(--cinnabar-bg);color:var(--cinnabar);border-color:rgba(199,48,79,.3)}

/* ── 三栏 ─────────────────────────────────────────────── */
.body{display:grid;grid-template-columns:266px 1fr 336px;min-height:0}
.rail,.insp{background:var(--card);display:flex;flex-direction:column;min-height:0}
.rail{border-right:1px solid var(--rule)}
.insp{border-left:1px solid var(--rule)}
.scroll{overflow:auto;min-height:0;flex:1}
.scroll::-webkit-scrollbar{width:9px;height:9px}
.scroll::-webkit-scrollbar-thumb{background:var(--rule);border-radius:5px;border:2px solid var(--card)}
.scroll::-webkit-scrollbar-thumb:hover{background:var(--ink4)}

.kicker{
  font-family:var(--f-mono);font-size:9.5px;letter-spacing:.2em;color:var(--ink3);
  text-transform:uppercase;padding:14px 14px 7px;
}
.tabs{display:flex;flex-wrap:wrap;gap:3px;padding:0 11px 11px;border-bottom:1px solid var(--rule2)}
.tab{
  border:1px solid var(--rule);background:var(--card);border-radius:3px;
  padding:4px 8px;font-size:11.5px;cursor:pointer;display:flex;gap:6px;align-items:baseline;transition:.15s;
}
.tab:hover{background:var(--sunk)}
.tab.on{background:var(--ink);color:var(--card);border-color:var(--ink)}
.tab.on i{color:rgba(255,255,255,.62)}
.tab i{font-style:normal;font-family:var(--f-mono);font-size:10px;color:var(--ink3)}
.tab.opt{border-style:dashed}

.list{padding:6px 0 20px}
.item{
  display:block;width:100%;text-align:left;background:none;border:0;border-left:2px solid transparent;
  padding:6px 14px;cursor:pointer;line-height:1.5;transition:.12s;
}
.item:hover{background:var(--sunk)}
.item.on{background:var(--gold-bg);border-left-color:var(--gold)}
.item b{font-weight:400;display:block;font-size:12.5px}
.item span{font-family:var(--f-mono);font-size:10px;color:var(--ink3)}
.item.faded{opacity:.4}

/* ── 舞台 ─────────────────────────────────────────────── */
.stage{display:flex;flex-direction:column;min-width:0;min-height:0}
.tools{
  padding:9px 14px;border-bottom:1px solid var(--rule);background:var(--card);
  display:flex;flex-direction:column;gap:9px;
}
.tool-row{display:flex;align-items:center;gap:10px;flex-wrap:wrap}
.tool-lab{font-family:var(--f-mono);font-size:9.5px;letter-spacing:.16em;color:var(--ink3);text-transform:uppercase;white-space:nowrap}
.chip{
  border:1px solid var(--rule);background:var(--card);border-radius:3px;
  padding:3px 9px;font-family:var(--f-mono);font-size:10.5px;cursor:pointer;
  color:var(--ink3);transition:.15s;white-space:nowrap;
}
.chip:hover{border-color:var(--ink4)}
.chip.on{color:var(--ink);border-color:var(--ink3);background:var(--sunk)}
.chip.on[data-st="narrated"]{background:var(--gold-bg);border-color:var(--gold);color:var(--gold)}
.chip.on[data-st="claim"]{background:var(--cinnabar-bg);border-color:var(--cinnabar);color:var(--cinnabar)}
.chip.on[data-st="disputed"]{background:rgba(30,138,116,.1);border-color:var(--verdi);color:var(--verdi)}
.chip small{font-size:9.5px;opacity:.7;margin-left:4px}

.slider{flex:1;min-width:160px;accent-color:var(--gold);height:18px}
.pos{font-family:var(--f-mono);font-size:11px;color:var(--ink);min-width:118px;white-space:nowrap}
.pos b{color:var(--gold);font-weight:400}

.canvas{flex:1;min-height:0;position:relative;background:
  linear-gradient(var(--rule2) 1px,transparent 1px) 0 0/100% 28px,
  linear-gradient(90deg,var(--rule2) 1px,transparent 1px) 0 0/28px 100%,var(--paper);
}
.canvas svg{width:100%;height:100%;display:block;cursor:grab}
.canvas svg.drag{cursor:grabbing}
.hint{
  position:absolute;left:14px;bottom:12px;font-family:var(--f-mono);font-size:10px;
  color:var(--ink4);pointer-events:none;line-height:1.8;
}

.edge{fill:none;transition:stroke-opacity .15s}
.edge-lab{font-family:var(--f-mono);font-size:8.5px;fill:var(--ink3);pointer-events:none;transition:opacity .15s}
.node{cursor:pointer}
.node-shape{transition:filter .15s}
.node:hover .node-shape{filter:brightness(.96)}
.node.on .node-shape{stroke-width:2.6}
.node-lab{font-family:var(--f-body);font-size:11.5px;fill:var(--ink);text-anchor:middle;pointer-events:none;font-weight:400}
.node-sub{font-family:var(--f-mono);font-size:8.5px;fill:var(--ink3);text-anchor:middle;pointer-events:none}
.dim{opacity:.16}

/* ── 检视器 ───────────────────────────────────────────── */
.insp-head{padding:14px 14px 12px;border-bottom:1px solid var(--rule2)}
.insp-type{font-family:var(--f-mono);font-size:9.5px;letter-spacing:.2em;color:var(--ink3);text-transform:uppercase}
.insp-name{font-family:var(--f-display);font-weight:700;font-size:19px;letter-spacing:.03em;margin:5px 0 2px;line-height:1.4}
.insp-id{font-family:var(--f-mono);font-size:10.5px;color:var(--ink3)}
.fields{padding:2px 0 0}
.f{display:flex;gap:10px;padding:6px 14px;border-bottom:1px solid var(--rule2);align-items:baseline}
.f dt{font-family:var(--f-mono);font-size:9.5px;letter-spacing:.1em;color:var(--ink3);width:92px;flex:0 0 92px;text-transform:uppercase}
.f dd{margin:0;font-size:12px;min-width:0;word-break:break-word;flex:1}
.f dd.mono{font-family:var(--f-mono);font-size:11px}
.f dd.na{color:var(--ink4);font-family:var(--f-mono);font-size:11px}
.ref{
  border:0;background:none;padding:0;font:inherit;color:var(--gold);cursor:pointer;
  border-bottom:1px solid rgba(168,117,21,.4);
}
.ref:hover{background:var(--gold-bg)}
.sub{font-family:var(--f-mono);font-size:9.5px;letter-spacing:.2em;color:var(--ink3);text-transform:uppercase;padding:16px 14px 8px;border-top:1px solid var(--rule2)}
.pad{padding:0 14px 14px}
.none{color:var(--ink4);font-size:12px;padding:0 14px 12px;font-style:italic}

/* ── 认识论：墨色浓度阶梯 ─────────────────────────────── */
.fact{
  display:block;width:100%;text-align:left;border:1px solid transparent;
  padding:6px 9px;margin-bottom:5px;border-radius:2px;font-size:12px;line-height:1.6;
  background:var(--sunk);cursor:pointer;transition:.12s;
}
.fact:hover{filter:brightness(.975)}
.fact .p{font-family:var(--f-mono);font-size:11px}
.fact .h{font-family:var(--f-mono);font-size:9.5px;color:var(--ink3);margin-left:6px}
.fact .fid{font-family:var(--f-mono);font-size:9.5px;color:var(--ink4);float:right;margin-left:8px}

.st-narrated  {background:var(--gold-bg);border-color:rgba(168,117,21,.42);color:var(--ink)}
.st-narrated .p{color:var(--gold)}
.st-claim     {background:var(--card);border-color:rgba(199,48,79,.4);color:var(--ink)}
.st-claim .p{color:var(--cinnabar)}
.st-belief    {background:var(--card);border-color:var(--rule);border-style:dashed;color:var(--ink2)}
.st-belief .p{color:var(--ink2)}
.st-speculation{background:var(--card);border-color:var(--rule2);border-style:dashed;color:var(--ink3)}
.st-speculation .p{color:var(--ink3)}
.st-disputed  {border-color:rgba(30,138,116,.4);color:var(--ink2);
  background:repeating-linear-gradient(135deg,transparent 0 5px,rgba(30,138,116,.11) 5px 6px)}
.st-disputed .p{color:var(--verdi)}
.st-inference {background:var(--card);border-color:var(--rule2);border-style:dotted;color:var(--ink3);font-style:italic}
.st-inference .p{color:var(--ink3)}
.st-dead{opacity:.45}
.st-dead .obj{text-decoration:line-through;text-decoration-color:var(--ink4)}
.fact.on{box-shadow:0 0 0 2px rgba(168,117,21,.35)}

/* ── 弹层 ─────────────────────────────────────────────── */
.sheet{
  position:fixed;inset:0;background:rgba(27,24,48,.28);display:none;
  align-items:center;justify-content:center;z-index:80;padding:24px;
}
.sheet.open{display:flex}
.sheet-in{
  background:var(--card);border-radius:4px;max-width:640px;width:100%;max-height:76vh;
  display:flex;flex-direction:column;box-shadow:0 24px 60px -20px rgba(27,24,48,.4);
}
.sheet-h{padding:16px 18px;border-bottom:1px solid var(--rule);display:flex;align-items:center;gap:12px}
.sheet-h b{font-family:var(--f-display);font-size:15px;font-weight:700;flex:1}
.issue{padding:9px 18px;border-bottom:1px solid var(--rule2);font-size:12px;display:flex;gap:10px}
.issue em{font-family:var(--f-mono);font-style:normal;font-size:10px;flex:0 0 auto;padding-top:2px}
.issue.error em{color:var(--cinnabar)}
.issue.warn em{color:var(--gold)}
.issue code{font-family:var(--f-mono);font-size:11px;color:var(--ink2)}

.stat{display:grid;grid-template-columns:1fr auto;gap:8px;padding:4px 14px;font-size:12px;align-items:center}
.stat span{font-family:var(--f-mono);font-size:11px;color:var(--ink2)}
.meter{height:4px;background:var(--rule2);border-radius:2px;overflow:hidden;grid-column:1/-1;margin-bottom:4px}
.meter i{display:block;height:100%;background:var(--gold)}

@media (max-width:1180px){
  .body{grid-template-columns:220px 1fr 300px}
}
@media (max-width:920px){
  body{overflow:auto}
  .app{height:auto}
  .body{grid-template-columns:1fr}
  .rail,.insp{border:0;border-bottom:1px solid var(--rule)}
  .canvas{height:62vh}
  .scroll{max-height:320px}
}
@media (prefers-reduced-motion:reduce){*{transition-duration:.01ms!important}}
</style>
</head>
<body>

<div class="app">
  <header class="bar">
    <span class="brand">记忆图查看器</span>
    <span class="schema" id="schema-tag">—</span>
    <span class="bar-sp"></span>
    <input class="search" id="search" type="search" placeholder="搜索 id、名称、别名、谓词…" aria-label="搜索记录">
    <button class="btn" id="btn-stats" type="button">统计</button>
    <button class="btn" id="btn-load" type="button">载入数据集</button>
    <button class="badge ok" id="badge" type="button">—</button>
    <input type="file" id="file" accept=".json,application/json" hidden>
  </header>

  <div class="body">
    <nav class="rail">
      <p class="kicker">记录类型</p>
      <div class="tabs" id="tabs"></div>
      <div class="scroll"><div class="list" id="list"></div></div>
    </nav>

    <section class="stage">
      <div class="tools">
        <div class="tool-row">
          <span class="tool-lab">读到</span>
          <input class="slider" id="slider" type="range" min="1" max="80" value="80" aria-label="叙述位置">
          <span class="pos" id="pos">第 1 章 第 <b>80</b> 段</span>
          <button class="chip on" id="chip-all" type="button">读完全章</button>
        </div>
        <div class="tool-row">
          <span class="tool-lab">状态</span>
          <span id="chips"></span>
        </div>
        <div class="tool-row">
          <span class="tool-lab">图层</span>
          <button class="chip on" data-layer="kinds" type="button">类型节点</button>
          <button class="chip" data-layer="isa" type="button">isa 边</button>
          <button class="chip" data-layer="episodes" type="button">场景节点</button>
          <button class="chip" data-layer="labels" type="button">边标签</button>
          <span class="bar-sp"></span>
          <button class="chip" id="relayout" type="button">重新布局</button>
        </div>
      </div>
      <div class="canvas">
        <svg id="svg" role="img" aria-label="记忆图">
          <defs>
            <marker id="a-ink" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="5.5" markerHeight="5.5" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 z" fill="#8b87a3"></path></marker>
            <marker id="a-gold" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="5.5" markerHeight="5.5" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 z" fill="#a87515"></path></marker>
            <marker id="a-cin" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="5.5" markerHeight="5.5" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 z" fill="#c7304f"></path></marker>
            <marker id="a-ver" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="5.5" markerHeight="5.5" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 z" fill="#1e8a74"></path></marker>
          </defs>
          <g id="vp">
            <g id="edges"></g>
            <g id="nodes"></g>
          </g>
        </svg>
        <p class="hint">拖节点可固定位置 · 拖空白平移 · 滚轮缩放 · 圆＝continuous 六边＝functional 方＝nominal 虚线＝provisional／Kind</p>
      </div>
    </section>

    <aside class="insp">
      <div class="scroll" id="insp"></div>
    </aside>
  </div>
</div>

<div class="sheet" id="sheet">
  <div class="sheet-in">
    <div class="sheet-h"><b id="sheet-title">—</b><button class="btn" id="sheet-close" type="button">关闭</button></div>
    <div class="scroll" id="sheet-body"></div>
  </div>
</div>

<script type="application/json" id="dataset">
{"memory":{"schema":"nbook.novel-memory/v4-spike","provenance":{"method":"人工通读手工装填，不是抽取管线输出","model":"memory-model-v4.md 第 5、6 节","sourceText":"../t01-novel-understanding-spike/evidences/chapter-001-source-normalized.txt","sourceNormalization":"chapter-source-normalization/v1，文件第 N 行即第 N 段","companion":"evidences/chapter-01-beats.json 是同一章的另一半（正文怎么切）。时刻的真源在那个文件里，本文件的 timeRef 按 id 引用它；主体 id 两边必须一致，scripts/build-viewer.ts 会核对","note":"本文件不构成任何召回率或准确率证据。v2 版本（nbook.novel-memory/v2-spike，8 个 Episode、26 条 Fact）已按 v4 第 11 节 W6 的倾向重建，不是迁移——v2 的 Episode 与 v4 的 Beat 不是同一个尺度，逐条搬运没有意义"},"chapter":1,"chapterTitle":"反派魔法少女","paragraphCount":77,"facets":{"note":"库内粗分面，不是内容。我们贴的标签，没有来源也没有叙述位置，只用来给查看器分组。与下面的 kinds 严格分开——见 findings 第 4 条","values":["人物","身体","物品","地点","概念"]},"kinds":[{"id":"K_fox_girl","name":"狐女","note":"第 11 段「一只娇小的金毛狐女」","category":"body"},{"id":"K_codex","name":"典籍","note":"第 8 段「这本飘浮在半空中的黑色古书」","category":"item"},{"id":"K_sapient","name":"智慧体","note":"文本从没说过它有自我意识。这个类只能由读者推断挂上去，且按第 5.2 节不能反过来当推理前提","category":"character"},{"id":"K_candidate","name":"适格者","note":"第 30、31 段古书自称在找的那种人","category":"character"},{"id":"K_star_envoy","name":"星界使者","note":"第 45 段古书的自我定位","category":"character"},{"id":"K_magical_girl","name":"魔法少女","note":"第 67 段","category":"character"},{"id":"K_villain_mg","name":"反派魔法少女","note":"第 1 段章标题就出现了，正文第 64 段才由古书说出","category":"character"},{"id":"K_oudou","name":"王道系","note":"第 69 段古书说这一款魔法少女是王道系的","category":"concept"},{"id":"K_creator","name":"造物主","note":"第 67 段，只有古书提过一次","category":"character"}],"entities":[{"id":"su_tianqing","label":"苏天晴","note":"库内标签不是读者知道的名字。读者知道的名字由 (su_tianqing, 专名) 这个槽在某个叙述位置上求值得到"},{"id":"codex","label":"黑色古书","intro":[{"at":12,"text":"一本浮在半空的黑色古书，能以低沉的声音说话。来历不明。"},{"at":32,"text":"墨丘利秘典。自称从星空彼岸而来，为寻找它最优秀的适格者。"}],"note":"第 5.1 节那两条介绍的出处。只存一份全局介绍，读到第 12 段的检索就会泄漏第 30 段才揭晓的专名"},{"id":"body_fox","label":"这具狐女身体","intro":[{"at":8,"text":"镜子里那道陌生的娇小身影。是谁不清楚。"},{"at":12,"text":"一只娇小的金毛狐女：金色长发、毛茸茸的兽耳、白皙的肌肤、背后一只炸毛的大尾巴。"}],"note":"身体是主体。苏天晴与这具身体是两个节点，「她居于其中」是一条读者推断，不是默认前提"},{"id":"body_prev","label":"原来的身体","note":"第 73 段她想回去的那具。本章只有这一处提及"},{"id":"tainai","label":"太奶","note":"第 16 段，猝死前听见她说话。文本没说她是活人还是幻觉"},{"id":"contract","label":"那份契约"},{"id":"star_beyond","label":"星空彼岸","note":"只由古书说出，叙述者一次也没提"},{"id":"room","label":"昏暗的房间"},{"id":"noodle_stall","label":"街边面摊"},{"id":"task_set","label":"那一整套任务"}],"predicates":[{"id":"P_proper_name","name":"专名","cardinality":"single","volatility":"low","note":"正式名字。与「称呼」分开，因为查看器要用它当揭晓前后的显示名"},{"id":"P_appellation","name":"称呼","cardinality":"multi","volatility":"low","note":"文本用来指称它的说法，可以有很多个"},{"id":"P_kind","name":"类","cardinality":"multi","volatility":"low","note":"值指向一个类。文本说出来的类别才走这里，库内粗分面走 entity.facet"},{"id":"P_voice","name":"声音","cardinality":"single","volatility":"low"},{"id":"P_hair","name":"发色","cardinality":"single","volatility":"low"},{"id":"P_ear","name":"耳型","cardinality":"single","volatility":"low","note":"第 5.3 节的例子。耳朵当前是耷拉还是竖起不建槽，那个每一拍都在变"},{"id":"P_ear_count","name":"耳朵数量","cardinality":"single","volatility":"low"},{"id":"P_skin","name":"肤色","cardinality":"single","volatility":"low"},{"id":"P_features","name":"五官","cardinality":"single","volatility":"low"},{"id":"P_tail","name":"尾巴","cardinality":"multi","volatility":"low","note":"基数被迫写成 multi，理由不正当——它只有一条尾巴。写 multi 是为了让第 12 段的外观和第 18 段的触感并存，而不是被判成竞争。见 findings 第 3 条"},{"id":"P_build","name":"体型","cardinality":"single","volatility":"low"},{"id":"P_foot","name":"脚","cardinality":"single","volatility":"low"},{"id":"P_wearing","name":"穿着","cardinality":"single","volatility":"medium","note":"在小说里穿着换得比发色勤。本章只有一条披露，建槽属于边界判断"},{"id":"P_prev_owner","name":"原来的主人","cardinality":"single","volatility":"low"},{"id":"P_inhabits","name":"居于哪具身体","cardinality":"single","volatility":"low"},{"id":"P_cause_of_death","name":"死因","cardinality":"single","volatility":"low"},{"id":"P_prev_work","name":"前世的工作状况","cardinality":"single","volatility":"medium"},{"id":"P_kin","name":"亲属","cardinality":"multi",